# ==========================================
# Kindle Calendar Dashboard - Environment Config
# ==========================================

# Port for the local dashboard server (default: 5055)
PORT=5055

# PostgreSQL Database Connection (Production & Local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/kindle_calendar

# City for Open-Meteo weather forecast (e.g. Padova, Milano, Roma)
CITY=Padova

# ClasseViva Credentials (optional - for school agenda, homework and tests)
CLASSEVIVA_USERNAME=YOUR_CLASSEVIVA_USERNAME
CLASSEVIVA_PASSWORD=YOUR_CLASSEVIVA_PASSWORD

# Groq API Key for AI task classification (optional - detects real tests vs homework)
# Model used: qwen/qwen3.8-27b or llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_groq_api_key_here

# Apple iCloud CalDAV (Recommended: Direct real-time sync without needing a Mac)
# Generate app-specific password at https://appleid.apple.com
ICLOUD_APPLE_ID=your_apple_id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Apple iCloud / External iCal URL (optional fallback)
ICLOUD_ICAL_URL=

# Kindle device parameters (used for deployment scripts)
KINDLE_IP=192.168.1.28
KINDLE_SSH_KEY=downloads/kindle_rsa
