# ==============================================================================
# Kindle Kiosk Client Configuration
# Copy this file to /mnt/us/kindle_kiosk.env on your Kindle to customize settings
# ==============================================================================

# URL of your dashboard server endpoint
SERVER_BASE="http://192.168.1.250:5055/api/image"

# NTP server for automatic background time synchronization
NTP_SERVER="pool.ntp.org"

# Path to fbink binary on Kindle (default: /mnt/us/usbnet/bin/fbink)
# FBINK="/mnt/us/usbnet/bin/fbink"
